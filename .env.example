# ===========================================
# Kirameku-Love 一键部署环境变量模板
# 复制为 .env 并填入真实值
# ===========================================

# ---------- 必填：数据库 ----------
DB_PASSWORD=your_strong_db_password_here

# ---------- 必填：JWT 密钥 (生产环境必须修改，建议 32+ 随机字符) ----------
SECRET_KEY=your_super_secret_key_change_in_production_min_32_chars

# ---------- 必填：域名配置 (三个子域名，需提前解析到服务器 IP) ----------
API_DOMAIN=api.www.zsljl.cn      # 后端 API 域名
WEB_DOMAIN=www.zsljl.cn     # 前端网站域名
ADMIN_DOMAIN=admin.www.zsljl.cn  # 后台管理域名

# CORS 允许的前端域名（逗号分隔）
CORS_ORIGINS=https://www.zsljl.cn,https://admin.www.zsljl.cn

# ---------- 必填：微信开放平台 (头像获取功能需要) ----------
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# ---------- 选填：高德地图 (地图模块需要) ----------
AMAP_WEB_SERVICE_KEY=your_amap_key

# ---------- 选填：阿里云 OSS (媒体存储，不填则用本地存储) ----------
STORAGE_TYPE=local  # 或 oss
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_CUSTOM_DOMAIN=  # 绑定的自定义域名（可选）
OSS_PREFIX=love/

# ---------- 选填：初始超级用户 (首次部署自动创建) ----------
CREATE_SUPERUSER=true
SUPERUSER_EMAIL=admin@yourdomain.com
SUPERUSER_PASSWORD=your_admin_password

# ===========================================
# 🚀 部署步骤：
# 1. cp .env.example .env
# 2. vim .env  # 填入上述必填项
# 3. 推送到 GitHub main 分支，或手动触发 Actions
# ===========================================